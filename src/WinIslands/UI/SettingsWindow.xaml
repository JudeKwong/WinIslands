<Window x:Class="WinIslands.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WinIslands.UI.Converters"
        xmlns:ui="clr-namespace:WinIslands.UI"
        Title="WinIslands 设置" Width="790" Height="720" MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        PreviewMouseWheel="Root_PreviewMouseWheel"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- 隐式文本默认前景色：确保深色模式下所有 TextBlock 为浅色文字、浅色模式为深色文字，
             防止遗漏的控件（Popup/模板/DataTemplate 等继承断裂处）仍显示默认黑色。 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="6" BorderThickness="1.2"
                                    Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,-1,0,0"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource ControlBorderBrush}"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource ControlBgBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="Slide" Focusable="False">
                                <Border x:Name="DropDown" CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource GlassBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" Margin="0,4,0,0" Padding="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource AccentBrush}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}"
                                                         Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="16,4,16,0" CornerRadius="13" Padding="5"
                                    Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Margin="16,10,16,16" CornerRadius="18"
                                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                    ClipToBounds="True" VerticalAlignment="Stretch">
                                <ContentPresenter ContentSource="SelectedContent" Margin="4" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="9" Padding="13,6" Margin="2" Background="Transparent" Cursor="Hand" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Margin="3,2" CornerRadius="3" Background="{DynamicResource ScrollTrackBrush}"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" CornerRadius="4" Margin="2" Background="{DynamicResource ScrollThumbBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="22" Margin="10"
            Background="Transparent" BorderBrush="{DynamicResource GlassOuterRimBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 静态毛玻璃装饰：统一模糊 + 半透明主题着色；无高光、无折射，不参与命中测试。 -->
            <ui:FrostedGlassLayer x:Name="FrostedEffect" Grid.RowSpan="3" IsHitTestVisible="False" CornerRadius="21" Intensity="1.0"/>

            <Grid x:Name="TitleBar" Grid.Row="0" Height="54" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="9" Margin="18,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WinIslands" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="设置" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Width="34" Height="34" Margin="0,0,14,0" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="NavList" Grid.Column="0" Margin="12,8,0,8" Padding="4,4"
                         Background="{DynamicResource SidebarBrush}" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="9" Padding="10,7" Margin="1,1" Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>

                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavGeneral" Text="通用" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavQuick" Text="快捷操作" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavAppearance" Text="外观" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavComponents" Text="组件" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavPlugins" Text="插件" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavPages" Text="页面管理" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavMedia" Text="媒体" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavMediaInfo" Text="媒体信息展示" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavLyrics" Text="歌词" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavCider" Text="Cider" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavIsland" Text="上岛 API" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
<ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavUpdate" Text="更新" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavAbout" Text="关于" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavEvents" Text="事件" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" Opacity="0.9"/>
                            <TextBlock x:Name="NavRules" Text="通知" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>


                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="26,16,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="PageSubtitle" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="230" VerticalAlignment="Top" Margin="14,3,0,0">
                            <TextBox x:Name="TxtSettingsSearch" FontSize="12" Padding="9,6,9,6"
                                     Background="{DynamicResource ControlBgBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextChanged="SettingsSearch_TextChanged" KeyDown="SettingsSearch_KeyDown"/>
                            <TextBlock x:Name="TxtSettingsSearchHint" Text="搜索设置…" FontSize="12"
                                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Grid>
                    <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0"
                                SelectionChanged="MainTabs_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </ControlTemplate>
                        </TabControl.Template>
                <TabItem x:Name="TabGeneral" Header="通用">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblLanguage" Style="{StaticResource Label}" Text="界面语言"/>
                            <ComboBox SelectedValuePath="Value" DisplayMemberPath="Display"
                                      SelectedValue="{Binding Language}">
                                <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                                <ComboBoxItem Tag="en-US" Content="English"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkStartWithWindows" Content="开机自启" IsChecked="{Binding Working.StartWithWindows}"/>
                            <CheckBox x:Name="ChkStartHidden" Content="启动时隐藏灵动岛" IsChecked="{Binding Working.StartHidden}"/>
                            <CheckBox x:Name="ChkHideWhenNoMedia" Content="无媒体播放时自动隐藏" IsChecked="{Binding Working.HideWhenNoMedia}"/>
                            <CheckBox x:Name="ChkFullScreenHide" IsChecked="{Binding Working.FullScreenAutoHideEnabled}"/>
                            <CheckBox x:Name="ChkLockScreenHide" IsChecked="{Binding Working.LockScreenAutoHideEnabled}"/>
                            <CheckBox x:Name="ChkShowWhenPaused" Content="暂停时仍然显示" IsChecked="{Binding Working.ShowWhenPaused}"/>
                            <CheckBox x:Name="ChkAlwaysVisible" IsChecked="{Binding Working.IslandAlwaysVisible}"/>
                            <TextBlock x:Name="LblDoubleClick" Style="{StaticResource Label}"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Working.DoubleClickAction}">
                                <ComboBoxItem x:Name="CbiDcPlayPause" Tag="PlayPause" Content="播放 / 暂停"/>
                                <ComboBoxItem x:Name="CbiDcToggleExpand" Tag="ToggleExpand" Content="展开 / 收起"/>
                                <ComboBoxItem x:Name="CbiDcShowDesktop" Tag="ShowDesktop" Content="显示桌面"/>
                                <ComboBoxItem x:Name="CbiDcToggleVisible" Tag="ToggleVisible" Content="隐藏 / 显示灵动岛"/>
                                <ComboBoxItem x:Name="CbiDcNext" Tag="NextTrack" Content="下一首"/>
                                <ComboBoxItem x:Name="CbiDcPrev" Tag="PrevTrack" Content="上一首"/>
                                <ComboBoxItem x:Name="CbiDcOpenSettings" Tag="OpenSettings" Content="打开设置"/>
                                <ComboBoxItem x:Name="CbiDcNone" Tag="None" Content="无动作"/>
                            </ComboBox>
                            <TextBlock x:Name="LblMiddleClick" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CmbMiddleClick" SelectedValuePath="Tag" SelectedValue="{Binding Working.MiddleClickAction}">
                                <ComboBoxItem x:Name="CbiMcPlayPause" Tag="PlayPause" Content="播放 / 暂停"/>
                                <ComboBoxItem x:Name="CbiMcToggleExpand" Tag="ToggleExpand" Content="展开 / 收起"/>
                                <ComboBoxItem x:Name="CbiMcShowDesktop" Tag="ShowDesktop" Content="显示桌面"/>
                                <ComboBoxItem x:Name="CbiMcToggleVisible" Tag="ToggleVisible" Content="隐藏 / 显示灵动岛"/>
                                <ComboBoxItem x:Name="CbiMcNext" Tag="NextTrack" Content="下一首"/>
                                <ComboBoxItem x:Name="CbiMcPrev" Tag="PrevTrack" Content="上一首"/>
                                <ComboBoxItem x:Name="CbiMcOpenSettings" Tag="OpenSettings" Content="打开设置"/>
                                <ComboBoxItem x:Name="CbiMcNone" Tag="None" Content="无动作"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkHoverExpand" IsChecked="{Binding Working.HoverExpandEnabled}"/>
                            <TextBlock x:Name="LblHoverExpandDelay" Style="{StaticResource Label}"/>
                            <Slider Minimum="0" Maximum="1500" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="20"
                                    Value="{Binding Working.HoverExpandDelayMs}"/>
                            <TextBlock x:Name="LblHoverCollapseDelay" Style="{StaticResource Label}"/>
                            <Slider Minimum="0" Maximum="2000" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="20"
                                    Value="{Binding Working.HoverCollapseDelayMs}"/>
                            <CheckBox x:Name="ChkWheelPage" IsChecked="{Binding Working.WheelPageNavigationEnabled}"/>
                            <CheckBox x:Name="ChkWheelInvert" IsChecked="{Binding Working.WheelPageInvertDirection}"/>
                            <TextBlock x:Name="TxtInteractionHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <CheckBox x:Name="ChkReduceMotion" IsChecked="{Binding Working.ReduceMotion}"/>
                            <CheckBox x:Name="ChkLowPower" IsChecked="{Binding Working.LowPowerMode}"/>
                            <CheckBox x:Name="ChkShowLunar" IsChecked="{Binding Working.ShowLunarOnDate}"/>
                            <CheckBox x:Name="ChkGlobalHotkeys" IsChecked="{Binding Working.GlobalHotkeysEnabled}"/>
                            <TextBlock x:Name="TxtHotkeysHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="LblHotkeyToggle" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyToggleVisible, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyPlayPause" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyPlayPause, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyNext" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyNext, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyPrev" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyPrev, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyExpand" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyExpand, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox x:Name="ChkQuickLauncher" IsChecked="{Binding Working.QuickLauncherEnabled}"/>
                            <TextBlock x:Name="LblHotkeyLauncher" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyLauncher, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblLowBattery" Style="{StaticResource Label}"/>
                            <Slider Minimum="0" Maximum="50" Value="{Binding Working.LowBatteryThreshold}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <TextBlock x:Name="LblKeyCaps" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                            <Slider Minimum="1" Maximum="10" Value="{Binding Working.KeyIndicatorSeconds}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtLowBatteryHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <CheckBox x:Name="ChkLowBatteryPersist" IsChecked="{Binding Working.LowBatteryPersistentEnabled}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="LblCharged" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                            <CheckBox x:Name="ChkChargedNotify" IsChecked="{Binding Working.ChargedNotifyEnabled}"/>
                            <TextBlock x:Name="LblChargedThreshold" Style="{StaticResource Label}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Working.ChargedThreshold}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <TextBlock x:Name="TxtChargedHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <Border Margin="0,16,0,4" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}">
                                <StackPanel>
                                    <Button x:Name="BtnResetSettings" Content="恢复默认设置" Padding="12,5"
                                            HorizontalAlignment="Left" Click="ResetSettings_Click"/>
                                    <TextBlock x:Name="TxtResetSettingsHint" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="将通用、外观、组件、媒体等所有设置恢复为出厂默认值（保留界面语言和插件配置）。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabQuick" Header="快捷操作">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <CheckBox x:Name="ChkQuickActions" IsChecked="{Binding Working.QuickActionsEnabled}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtQuickHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" MaxWidth="520"/>
                            <ItemsControl ItemsSource="{Binding QuickActionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                Padding="10,6" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="26" Height="24" Padding="0"
                                                            Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Opacity="0.75"
                                                            Click="QuickActionMove_Click" CommandParameter="{Binding Key}" Tag="-1" ToolTip="上移"/>
                                                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="26" Height="24" Padding="0"
                                                            Background="Transparent" BorderThickness="0" Opacity="0.75"
                                                            Click="QuickActionMove_Click" CommandParameter="{Binding Key}" Tag="1" ToolTip="下移"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabAppearance" Header="外观">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblTheme" Style="{StaticResource Label}" Text="主题"/>
                            <TextBlock x:Name="LblThemePreset" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding ThemePresetOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" SelectedValue="{Binding Working.ThemePreset}"/>
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" SelectedValue="{Binding Working.Theme}"/>
                            <CheckBox x:Name="ChkThemeScheduled" IsChecked="{Binding Working.ThemeScheduledEnabled}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="LblThemeDarkStart" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                                <Slider Minimum="0" Maximum="23" Value="{Binding Working.ThemeScheduleDarkStartHour}" Width="130" HorizontalAlignment="Left"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="LblThemeDarkEnd" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                                <Slider Minimum="0" Maximum="23" Value="{Binding Working.ThemeScheduleDarkEndHour}" Width="130" HorizontalAlignment="Left"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtThemeScheduleNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock x:Name="LblThemeTint" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtThemeTint" Width="130" HorizontalAlignment="Left"
                                     Text="{Binding Working.ThemeTint}"/>
                            <TextBlock x:Name="TxtThemeTintNote" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <TextBlock x:Name="LblAnimationStyle" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding AnimationStyleOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" SelectedValue="{Binding Working.AnimationStyle}"/>
                            <TextBlock x:Name="LblAnimDuration" Style="{StaticResource Label}"/>
                            <Slider Minimum="300" Maximum="1400" Value="{Binding Working.IslandAnimationDuration}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="50"/>
                            <TextBlock x:Name="TxtAnimDurationHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="480" HorizontalAlignment="Left"/>

                            <TextBlock x:Name="LblAccent" Style="{StaticResource Label}" Text="主题色"/>
                            <WrapPanel x:Name="ColorSwatches">
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="26" Height="26" Margin="2" Tag="{Binding}"
                                                    Background="{Binding}" BorderThickness="1" BorderBrush="#33000000"
                                                    ToolTip="{Binding}" Click="ColorSwatch_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <CheckBox x:Name="ChkWallpaperTheme" IsChecked="{Binding Working.WallpaperThemeColorEnabled}"/>
                            <TextBlock x:Name="LblFontFamily" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.FontFamily}"/>
                            <TextBlock x:Name="LblFontScale" Style="{StaticResource Label}"/>
                            <Slider Minimum="0.8" Maximum="1.4" Value="{Binding Working.FontScale}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblCornerRadius" Style="{StaticResource Label}"/>
                            <Slider Minimum="16" Maximum="40" Value="{Binding Working.CornerRadius}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="2"/>
                            <TextBox x:Name="AccentBox" Width="130" HorizontalAlignment="Left" Margin="2,4,0,0"
                                     Text="{Binding Working.AccentColor}"/>

                            <TextBlock x:Name="LblPosition" Style="{StaticResource Label}" Text="位置"/>
                            <ComboBox ItemsSource="{Binding PositionOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" SelectedValue="{Binding Working.Position}"/>
                            <CheckBox x:Name="ChkEdgeSnap" IsChecked="{Binding Working.EdgeSnapEnabled}" Content="拖动后自动吸附屏幕边缘 / 居中"/>

                            <TextBlock x:Name="LblMonitor" Style="{StaticResource Label}" Text="显示器"/>
                            <ComboBox ItemsSource="{Binding MonitorOptions}" SelectedValuePath="Value"
                                      DisplayMemberPath="Display" SelectedValue="{Binding Working.Monitor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="LblMonitorIndex" Text="屏幕编号" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox Width="70" Text="{Binding Working.MonitorIndex}"/>
                            </StackPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="LblOffsetX" Style="{StaticResource Label}" Text="水平偏移"/>
                                    <TextBox Text="{Binding Working.OffsetX}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblOffsetY" Style="{StaticResource Label}" Text="垂直偏移"/>
                                    <TextBox Text="{Binding Working.OffsetY}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LblOpacity" Style="{StaticResource Label}" Text="不透明度"/>
                            <Slider Minimum="0.3" Maximum="1" Value="{Binding Working.Opacity}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblIslandSize" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="LblCompactWidth" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="260" Maximum="520" Value="{Binding Working.CompactWidth}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="CompactWidth" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkCompactWidthAuto" IsChecked="{Binding Working.CompactWidthAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LblCompactHeight" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="48" Maximum="140" Value="{Binding Working.CompactHeight}" Width="230" IsSnapToTickEnabled="True" TickFrequency="1" Tag="CompactHeight" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkCompactHeightAuto" IsChecked="{Binding Working.CompactHeightAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LblExpandedWidth" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="340" Maximum="820" Value="{Binding Working.ExpandedWidth}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="ExpandedWidth" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkExpandedWidthAuto" IsChecked="{Binding Working.ExpandedWidthAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LblExpandedHeight" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="240" Maximum="820" Value="{Binding Working.MaxExpandedHeight}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="ExpandedHeight" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkExpandedHeightAuto" IsChecked="{Binding Working.MaxExpandedHeightAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkCoverTint" IsChecked="{Binding Working.CoverTintBackground}"/>
                            <CheckBox x:Name="ChkMarquee" IsChecked="{Binding Working.MarqueeTextEnabled}"/>
                            <CheckBox x:Name="ChkWave" IsChecked="{Binding Working.WaveVisualizerEnabled}"/>
                            <CheckBox x:Name="ChkNetCurve" IsChecked="{Binding Working.NetCurveEnabled}"/>
                            <CheckBox x:Name="ChkWaveSync" IsChecked="{Binding Working.WaveSyncEnabled}"/>
                            <TextBlock x:Name="LblWaveStyle" Style="{StaticResource Label}"/>
                            <ComboBox SelectedValuePath="Value" DisplayMemberPath="Display" Width="220" HorizontalAlignment="Left"
                                      SelectedValue="{Binding Working.WaveStyle}">
                                <ComboBox.ItemsSource>
                                    <Binding Path="WaveStyleOptions"/>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <TextBlock x:Name="LblWaveSensitivity" Style="{StaticResource Label}"/>
                            <Slider Minimum="0.2" Maximum="3" Value="{Binding Working.WaveSensitivity}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblWaveHeight" Style="{StaticResource Label}"/>
                            <Slider Minimum="0.4" Maximum="1.6" Value="{Binding Working.WaveHeight}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtWaveNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="480" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblWidgets" Style="{StaticResource Label}"/>
                            <CheckBox x:Name="ChkShowWidgets" IsChecked="{Binding Working.ShowWidgetsWhenNoMedia}"/>
                            <CheckBox x:Name="ChkWidgetTime" IsChecked="{Binding Working.WidgetShowTime}"/>
                            <CheckBox x:Name="ChkWidgetWeather" IsChecked="{Binding Working.WidgetShowWeather}"/>
                            <TextBlock x:Name="LblWeatherCity" Style="{StaticResource Label}"/>
                            <TextBox x:Name="WeatherCityBox" Width="200" HorizontalAlignment="Left" Text="{Binding Working.WeatherCity}"/>
                            <TextBlock x:Name="TxtWidgetNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <TextBlock x:Name="LblCompact" Style="{StaticResource Label}" Text="紧凑模式显示内容"/>
                            <CheckBox x:Name="ChkCompactArt" Content="封面" IsChecked="{Binding Working.CompactShowArt}"/>
                            <CheckBox x:Name="ChkCompactTitle" Content="歌名" IsChecked="{Binding Working.CompactShowTitle}"/>
                            <CheckBox x:Name="ChkCompactProgress" Content="进度条" IsChecked="{Binding Working.CompactShowProgress}"/>
                            <CheckBox x:Name="ChkSingleLine" IsChecked="{Binding Working.SingleLineMode}"/>
                            <CheckBox x:Name="ChkMiniPlayer" IsChecked="{Binding Working.MiniPlayerEnabled}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabComponents" Header="组件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblCompOrder" Text="选择需要的组件，拖动左侧手柄调整顺序。" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,2,2,8"/>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="4,2">
                                <ItemsControl x:Name="ComponentManageList" ItemsSource="{Binding ComponentManageRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid Margin="4,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="ComponentDragHandle" Width="20" Height="36" Background="Transparent" Cursor="SizeNS"
                                                            PreviewMouseLeftButtonDown="ComponentRow_DragHandleDown"
                                                            PreviewMouseMove="ComponentRow_DragHandleMove"
                                                            PreviewMouseLeftButtonUp="ComponentRow_DragHandleUp"
                                                            LostMouseCapture="ComponentRow_LostMouseCapture">
                                                        <TextBlock Text="⋮⋮" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" Text="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="4" FontSize="11" Height="28" VerticalAlignment="Center" Padding="3,2"
                                                             IsEnabled="{Binding SupportsIcon}" Visibility="{Binding SupportsIcon, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="{Binding IconPlaceholder, StringFormat={}默认：{0}}"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="空闲" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Idle, Mode=TwoWay}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="播放" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Playing, Mode=TwoWay}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="28,0,4,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock x:Name="TxtCompNote" Text="空闲 = 无歌曲播放时；播放 = 有歌曲播放时。" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,8,0,0"/>

                            <TextBlock x:Name="LblUsageMergeTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                            <CheckBox x:Name="ChkUsageMerge" IsChecked="{Binding Working.UsageMergeEnabled}"/>
                            <TextBlock x:Name="LblUsageMergeItems" Style="{StaticResource Label}"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkUsageMergeMic" IsChecked="{Binding Working.UsageMergeMic}" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ChkUsageMergeCam" IsChecked="{Binding Working.UsageMergeCam}" Margin="0,0,16,6"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtUsageMergeNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="520"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabPlugins" Header="插件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblPluginsIntro" Text="本地组件插件可扩展灵动岛常驻内容。插件在独立进程中运行，崩溃或超时不会影响主程序。" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,2,2,10"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="BtnOpenPluginManager" Content="打开插件管理" Padding="12,5" Click="OpenPluginManager_Click"/>
                                <Button x:Name="BtnOpenPluginFolder" Content="打开插件目录" Padding="12,5" Margin="8,0,0,0" Click="OpenPluginFolder_Click"/>
                                <Button x:Name="BtnOpenPluginGuide" Content="插件开发指南" Padding="12,5" Margin="8,0,0,0" Click="OpenPluginGuide_Click"/>
                                <Button x:Name="BtnReloadPlugins" Content="重新扫描" Padding="12,5" Margin="8,0,0,0" Click="ReloadPlugins_Click"/>
                                <Button x:Name="BtnCreateSamplePlugin" Content="创建示例插件" Padding="12,5" Margin="8,0,0,0" Click="CreateSamplePlugin_Click"/>
                            </WrapPanel>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10,4">
                                <StackPanel>
                                    <TextBlock x:Name="LblPluginCount" FontSize="11.5" FontWeight="SemiBold" Margin="2,4,0,2"/>
                                    <ItemsControl x:Name="PluginList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="4,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding VersionText}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="10.8" Margin="0,3,12,0" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding MetaText}" FontSize="10.2" Margin="0,2,12,0" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#22E74C3C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                            <Setter Property="Background" Value="#222ECC71"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtPluginEmpty" FontSize="11" Margin="4,10,4,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtPluginsHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="2,10,0,0"/>
                            <TextBlock x:Name="TxtPluginDependencyHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="2,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabPages" Header="页面管理">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock Text="选择需要的展开页面，拖动左侧手柄调整顺序。" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,2,2,8"/>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="4,2">
                                <ItemsControl x:Name="PageManageList" ItemsSource="{Binding PageManageRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid Margin="4,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="PageDragHandle" Width="20" Height="36" Background="Transparent" Cursor="SizeNS"
                                                            PreviewMouseLeftButtonDown="PageRow_DragHandleDown"
                                                            PreviewMouseMove="PageRow_DragHandleMove"
                                                            PreviewMouseLeftButtonUp="PageRow_DragHandleUp"
                                                            LostMouseCapture="PageRow_LostMouseCapture">
                                                        <TextBlock Text="⋮⋮" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}"
                                                              IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="28,0,4,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="至少保留一个页面。" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabMedia" Header="媒体">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <CheckBox x:Name="ChkUseSystemVolume" Content="非 Cider 来源时控制系统音量" IsChecked="{Binding Working.UseSystemVolume}"/>
                            <TextBlock x:Name="LblAudioOutput" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <ComboBox x:Name="CboAudioOutput" Width="380" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                      SelectionChanged="AudioOutput_SelectionChanged"/>
                            <TextBlock x:Name="TxtAudioOutputNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtMediaInfo" Text="媒体来源优先级：Cider 本地 API → Windows 全局媒体会话 (SMTC) → 窗口标题识别"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock x:Name="LblMediaApps" Style="{StaticResource Label}"/>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="4,2">
                                <ItemsControl ItemsSource="{Binding MediaAppRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4,2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Width="20" Height="20" Padding="0" FontSize="10" Background="Transparent" BorderThickness="0"
                                                            Content="▲" ToolTip="上移" Click="MediaUp_Click"/>
                                                    <Button Width="20" Height="20" Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Margin="2,0,0,0"
                                                            Content="▼" ToolTip="下移" Click="MediaDown_Click"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock x:Name="TxtMediaNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    Padding="14,12" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="媒体源检查" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="检查 SMTC、Cider、播放器进程与歌词来源是否正常。"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,12,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnMediaCheck" Grid.Column="1" Content="开始检查"
                                            Padding="14,7" VerticalAlignment="Center" Click="MediaCheck_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabMediaInfo" Header="媒体信息展示">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <CheckBox x:Name="ChkShowMediaInfo" IsChecked="{Binding Working.ShowMediaInfo}"/>
                            <TextBlock x:Name="LblExpandedSections" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                            <CheckBox x:Name="ChkExpandedArtTitle" IsChecked="{Binding Working.ExpandedShowArtTitle}"/>
                            <CheckBox x:Name="ChkExpandedProgress" IsChecked="{Binding Working.ExpandedShowProgress}"/>
                            <CheckBox x:Name="ChkExpandedControls" IsChecked="{Binding Working.ExpandedShowControls}"/>
                            <CheckBox x:Name="ChkExpandedLyrics" IsChecked="{Binding Working.ExpandedShowLyrics}"/>
                            <TextBlock x:Name="LblCardStyle" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                            <ComboBox x:Name="CboCardStyle" Width="320" HorizontalAlignment="Left" Padding="6,4"
                                      SelectionChanged="CardStyle_SelectionChanged"/>
                            <TextBlock x:Name="TxtMediaInfoNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabLyrics" Header="歌词">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                        <CheckBox x:Name="ChkLyricsSourcePick" IsChecked="{Binding Working.LyricsSourcePick}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblLyricsPreferredSource" Style="{StaticResource Label}" Margin="0,2,0,2"/>
                        <ComboBox ItemsSource="{Binding LyricsSourceOptions}" SelectedValuePath="Value"
                                  DisplayMemberPath="Display" SelectedValue="{Binding Working.LyricsPreferredSource}"
                                  Width="260" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="ChkAmllTtml" IsChecked="{Binding Working.AmllTtmlEnabled}" Margin="0,10,0,6"/>
                        <CheckBox x:Name="ChkOnlineLyrics" Content="在线歌词（网易云，非官方接口，默认开启）" IsChecked="{Binding Working.OnlineLyricsEnabled}"/>
                        <TextBlock x:Name="TxtLyricsNote" Text="在线歌词使用非官方接口，仅供个人学习，请尊重版权。" FontSize="11" Foreground="#E6A055" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <TextBlock x:Name="LblLyricsFolder" Style="{StaticResource Label}" Text="歌词文件夹（留空自动搜索）"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Working.LyricsFolder}"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Margin="6,0,0,0" Click="BrowseLyrics_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnClearLyricsCache" Content="清空远程歌词缓存" Padding="10,4" Click="ClearLyricsCache_Click"/>
                            <TextBlock x:Name="TxtLyricsCacheStatus" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>                        <CheckBox x:Name="ChkStandaloneLyrics" Content="启用独立歌词小窗" IsChecked="{Binding Working.StandaloneLyricsWindow}" Margin="0,10,0,0"/>
                        <CheckBox Content="逐字高亮（卡拉OK效果）" IsChecked="{Binding Working.KaraokeHighlight}"/>
                        <CheckBox x:Name="ChkBilingual" Content="双语歌词（自动合并相邻翻译行）" IsChecked="{Binding Working.BilingualLyrics}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LblLyricsOpacity" Style="{StaticResource Label}" Text="歌词小窗不透明度" Margin="0,12,0,0"/>
                        <Slider Minimum="0.3" Maximum="1" Value="{Binding Working.LyricsWindowOpacity}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="0.05"/>
                        <CheckBox x:Name="ChkLyricsLocked" Content="锁定歌词小窗（锁定后鼠标穿透，不挡操作）" IsChecked="{Binding Working.LyricsWindowLocked}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LblLyricsStyleTitle" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,14,0,0" Text="歌词样式"/>
                        <TextBlock x:Name="LblLyricsBaseSize" Style="{StaticResource Label}" Text="普通歌词字号"/>
                        <Slider Minimum="9" Maximum="28" Value="{Binding Working.LyricFontSize}" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="LblLyricsCurrentSize" Style="{StaticResource Label}" Text="当前行字号"/>
                        <Slider Minimum="12" Maximum="36" Value="{Binding Working.LyricCurrentFontSize}" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="LblLyricsLineSpacing" Style="{StaticResource Label}" Text="行间距"/>
                        <Slider Minimum="0.8" Maximum="2.0" Value="{Binding Working.LyricLineSpacing}" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                        <TextBlock x:Name="LblLyricsKaraokeSpeed" Style="{StaticResource Label}" Text="卡拉OK速度"/>
                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding Working.KaraokeSpeed}" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                        <TextBlock x:Name="LblLyricsHighlightColor" Style="{StaticResource Label}" Text="高亮颜色"/>
                        <TextBox Width="160" HorizontalAlignment="Left" Text="{Binding Working.LyricHighlightColor, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock x:Name="LblLyricsBaseColor" Style="{StaticResource Label}" Text="基础颜色"/>
                        <TextBox Width="160" HorizontalAlignment="Left" Text="{Binding Working.LyricBaseColor, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock x:Name="TxtLyricsColorNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="520"/>

                    </StackPanel>
</ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabCider" Header="Cider">
                    <StackPanel Margin="10,6">
                        <CheckBox x:Name="ChkCiderEnabled" Content="启用 Cider 本地 API" IsChecked="{Binding Working.CiderEnabled}"/>
                        <TextBlock x:Name="LblCiderPort" Style="{StaticResource Label}" Text="端口（0 = 自动检测，默认 10767）"/>
                        <TextBox Width="130" HorizontalAlignment="Left" Text="{Binding Working.CiderPort}"/>
                        <TextBlock x:Name="LblCiderToken" Style="{StaticResource Label}" Text="API Token（可留空）"/>
                        <TextBox Text="{Binding Working.CiderToken}" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtCiderHint" Text="在 Cider 中开启：设置 → 连接性 → 允许外部控制（Manage External Application Access），生成 Token 后填入。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="TabIsland" Header="上岛 API">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <CheckBox x:Name="ChkIslandApi" IsChecked="{Binding Working.IslandApiEnabled}"/>
                            <TextBlock x:Name="LblIslandPort" Style="{StaticResource Label}"/>
                            <TextBox Width="130" HorizontalAlignment="Left" Text="{Binding Working.IslandApiPort}"/>
                            <TextBlock x:Name="LblIslandToken" Style="{StaticResource Label}"/>
                            <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding Working.IslandApiToken}"/>
                            <TextBlock x:Name="LblIslandDuration" Style="{StaticResource Label}"/>
                            <Slider Minimum="5" Maximum="300" Value="{Binding Working.IslandApiDefaultDuration}" Width="300" HorizontalAlignment="Left"
                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <TextBlock x:Name="TxtIslandNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

<TabItem x:Name="TabUpdate" Header="Update">
                    <StackPanel Margin="10,6">
                        <TextBlock x:Name="LblUpdateChannel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbUpdateChannel" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="CmbUpdateChannelStable" Content="正式版"/>
                            <ComboBoxItem x:Name="CmbUpdateChannelBeta" Content="测试版（Beta）"/>
                        </ComboBox>
                        <CheckBox x:Name="ChkAutoUpdateCheck" IsChecked="{Binding Working.AutoUpdateCheck}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnCheckUpdate" Padding="14,6" Margin="0,0,8,0" Click="CheckUpdate_Click"/>
                            <Button x:Name="BtnRollback" Padding="14,6" Click="Rollback_Click"/>
                        </StackPanel>

                        <Button x:Name="BtnDownloadUpdate" Padding="14,6" Margin="0,8,0,0" Visibility="Collapsed" Click="DownloadUpdate_Click"/>
                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtUpdateStatus" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtUpdateNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="TabAbout" Header="关于">
                    <StackPanel Margin="10,6">
                        <TextBlock x:Name="TxtAbout" Text="WinIslands — Windows 灵动岛&#10;灵感来自 macOS Dynamic Island。&#10;基于 .NET 10 + WPF，仅使用系统媒体会话与本地 API。"
                                   FontSize="12" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnOpenConfig" Content="打开配置目录" Padding="10,4" Click="OpenConfigFolder_Click"/>
                            <Button x:Name="BtnDiagnostics" Content="诊断信息" Padding="10,4" Margin="8,0,0,0" Click="Diagnostics_Click"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="TabEvents" Header="事件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,6">
                        <CheckBox x:Name="ChkBluetoothNotify" IsChecked="{Binding Working.BluetoothNotifyEnabled}"/>
                        <CheckBox x:Name="ChkCallNotify" IsChecked="{Binding Working.CallNotifyEnabled}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="LblCallApps" Style="{StaticResource Label}" Text="检测的应用（进程名，逗号分隔）" Margin="0,4,0,0"/>
                        <TextBox x:Name="TxtCallApps" Text="{Binding CallNotifyAppsText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="430" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkNetworkNotify" IsChecked="{Binding Working.NetworkNotifyEnabled}"/>
                        <CheckBox x:Name="ChkDiskAlert" IsChecked="{Binding Working.DiskAlertEnabled}"/>
                        <TextBlock x:Name="LblDiskThreshold" Style="{StaticResource Label}"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Working.DiskAlertThresholdGB}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="5"/>
                        <TextBlock x:Name="TxtDiskThresholdHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="LblDndTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <CheckBox x:Name="ChkDndManual" IsChecked="{Binding Working.DoNotDisturbManual}"
                                  Checked="DndOption_Changed" Unchecked="DndOption_Changed"/>
                        <CheckBox x:Name="ChkDndSchedule" IsChecked="{Binding Working.DoNotDisturbEnabled}"
                                  Checked="DndOption_Changed" Unchecked="DndOption_Changed"/>
                        <TextBlock x:Name="TxtDndStatus" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Button x:Name="BtnDndNow" Padding="12,5" HorizontalAlignment="Left" Margin="0,4,0,2"
                                Click="DndNow_Click"/>
                        <TextBlock x:Name="LblDndStart" Style="{StaticResource Label}"/>
                        <Slider Minimum="0" Maximum="23" Value="{Binding Working.DoNotDisturbStartHour}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="LblDndEnd" Style="{StaticResource Label}"/>
                        <Slider Minimum="0" Maximum="23" Value="{Binding Working.DoNotDisturbEndHour}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtDndNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock x:Name="LblDndAllowlist" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtDndAllowlist" Text="{Binding Working.DnDAllowlistText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="430" Height="54" HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="8,5" FontSize="11.5"/>

<TextBlock x:Name="LblVolTempTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <CheckBox x:Name="ChkVolTemp" IsChecked="{Binding Working.VolumeTempIndicatorEnabled}"/>
                        <TextBlock x:Name="LblVolTempSeconds" Style="{StaticResource Label}"/>
                        <Slider Minimum="1" Maximum="10" Value="{Binding Working.VolumeTempIndicatorSeconds}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="1"/>

                        <TextBlock x:Name="LblCalendarTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <CheckBox x:Name="ChkCalendarEnabled" IsChecked="{Binding Working.CalendarEnabled}"/>
                        <TextBlock x:Name="LblCalendarPath" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtCalendarPath" Text="{Binding Working.CalendarIcsPath, UpdateSourceTrigger=PropertyChanged}"
                                     Width="430" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"/>
                            <Button x:Name="BtnCalendarPick" Padding="10,4" Margin="8,0,0,0" Click="CalendarPick_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="LblCalendarAdvance" Style="{StaticResource Label}"/>
                        <Slider Minimum="0" Maximum="120" Value="{Binding Working.CalendarAdvanceMinutes}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="5"/>
                        <TextBlock x:Name="TxtCalendarNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="520"/>

                        <TextBlock x:Name="LblRssTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <CheckBox x:Name="ChkRssEnabled" IsChecked="{Binding Working.RssNotifyEnabled}"/>
                        <TextBlock x:Name="LblRssUrls" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtRssUrls" Text="{Binding Working.RssUrls, UpdateSourceTrigger=PropertyChanged}"
                                 Width="430" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="LblRssInterval" Style="{StaticResource Label}"/>
                        <Slider Minimum="5" Maximum="120" Value="{Binding Working.RssIntervalMinutes}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="5"/>
                        <TextBlock x:Name="TxtRssNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="520"/>

                        <TextBlock x:Name="LblMailTitle" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <CheckBox x:Name="ChkMailEnabled" IsChecked="{Binding Working.MailNotifyEnabled}"/>
                        <TextBlock x:Name="LblMailServer" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtMailServer" Text="{Binding Working.MailPop3Server, UpdateSourceTrigger=PropertyChanged}"
                                     Width="330" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"/>
                            <TextBox x:Name="TxtMailPort" Text="{Binding Working.MailPop3Port, UpdateSourceTrigger=PropertyChanged}"
                                     Width="84" Margin="8,0,0,0" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkMailSsl" IsChecked="{Binding Working.MailUseSsl}"/>
                        <TextBlock x:Name="LblMailUser" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtMailUser" Text="{Binding Working.MailUser, UpdateSourceTrigger=PropertyChanged}"
                                 Width="330" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"/>
                        <TextBlock x:Name="LblMailPass" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="TxtMailPass" Width="330" HorizontalAlignment="Left" Padding="8,5" FontSize="11.5"
                                     PasswordChanged="MailPass_PasswordChanged"/>
                        <TextBlock x:Name="LblMailInterval" Style="{StaticResource Label}"/>
                        <Slider Minimum="1" Maximum="60" Value="{Binding Working.MailCheckMinutes}" Width="300" HorizontalAlignment="Left"
                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtMailNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="520"/>

                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="TabRules" Header="通知">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblNotificationsIntro" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="560"/>
                            <TextBlock x:Name="LblNotificationMode" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CboNotificationMode" ItemsSource="{Binding NotificationFilterModeOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding NotificationAppFilterMode}"
                                      Width="260" HorizontalAlignment="Left" Padding="8,5"/>
                            <TextBlock x:Name="LblNotificationApps" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                            <TextBox x:Name="TxtNotificationApps" Text="{Binding NotificationAppFiltersText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="520" Height="132" HorizontalAlignment="Left" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"/>
                            <TextBlock x:Name="TxtNotificationAppsHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="560"/>
                            <Border Height="1" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.25" Margin="0,16,0,14" HorizontalAlignment="Left" Width="520"/>
                            <CheckBox x:Name="ChkNotificationTakeover" IsChecked="{Binding Working.NotificationTakeoverEnabled}"/>
                            <Grid Margin="0,12,0,0" HorizontalAlignment="Left" Width="520">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblNotificationTimeout" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Working.NotificationTimeoutSeconds}" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" MinWidth="40" VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding Working.NotificationTimeoutSeconds, StringFormat={}{0} s}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0" HorizontalAlignment="Left" Width="520">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblNotificationQueue" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Working.NotificationQueueMax}" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" MinWidth="40" VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding Working.NotificationQueueMax, StringFormat={}{0}}"/>
                            </Grid>
                            <CheckBox x:Name="ChkNotificationFold" IsChecked="{Binding Working.NotifyFoldEnabled}" Margin="0,12,0,0"/>
                            <CheckBox x:Name="ChkNotificationDebounce" IsChecked="{Binding Working.NotificationDebounce}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="ChkCopyToast" IsChecked="{Binding Working.CopyToastEnabled}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem></TabControl>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,16">
                <Button x:Name="BtnExport" Content="导出配置" Padding="12,5" Margin="0,0,8,0" Click="Export_Click"/>
                <Button x:Name="BtnImport" Content="导入配置" Padding="12,5" Margin="0,0,8,0" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
