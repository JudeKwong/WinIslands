                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Battery">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource BatteryItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Volume">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource VolumeItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="CapsLock">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CapsLockItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Clipboard">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ClipboardItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Todo">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TodoItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Timer">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TimerItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Schedule">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ScheduleItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Holiday">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource HolidayItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Meeting">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource MeetingItem}"/>
                                                </DataTrigger>
