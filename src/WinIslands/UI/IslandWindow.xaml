                    </ItemsControl>
                    </StackPanel>

                    <!-- 低电量常驻胶囊 + 媒体控制按钮（靠右） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- 低电量常驻指示（1.2.4）：电量低于阈值且未接电源时右上角胶囊常驻显示，随电量变化，不反复弹通知 -->
                        <Border CornerRadius="9" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{Binding LowBatteryBadgeBackground}"
                                Visibility="{Binding ShowLowBatteryBadge, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEBA0;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                           VerticalAlignment="Center" Foreground="{Binding LowBatteryBadgeBrush}"/>
                                <TextBlock Text="{Binding LowBatteryBadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{Binding LowBatteryBadgeBrush}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <!-- 声音波纹：随音量起伏（紧凑行） -->
                                                <StackPanel x:Name="WaveBoxCompact" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding HasWave, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel x:Name="WaveBarsPanelCompact" Orientation="Horizontal">
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC1" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC2" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC3" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC4" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC5" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC6" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                            <Border Width="2.2" Height="12" CornerRadius="1.1" VerticalAlignment="Center" Margin="0,0,1.8,0"
                                Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform><ScaleTransform x:Name="WaveBarC7" ScaleY="0.16"/></Border.RenderTransform>
                            </Border>
                        </StackPanel>
                            <Grid x:Name="WaveSpectrumHostCompact" Width="46" Height="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Grid x:Name="WaveRingHostCompact" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <Grid x:Name="WaveParticlesHostCompact" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PlayPauseCommand}">
                            <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ═══ 展开内容 ═══ -->
                <ScrollViewer x:Name="ExpandedContent" Grid.Row="0" Grid.RowSpan="2" Margin="0,10,0,0"
                              Background="Transparent"
                              Visibility="Collapsed" Opacity="0" VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.985" ScaleY="0.985"/>
                            <TranslateTransform x:Name="ExpandedTranslate" Y="8"/>
                        </TransformGroup>
                    </ScrollViewer.RenderTransform>
                    <StackPanel>
                    <!-- 上岛推送详情（第三方软件推送，展开时优先级最高，置于顶部） -->
                    <Border x:Name="ExpandedPushCard" Visibility="{Binding HasActivePush, Converter={StaticResource BoolToVis}}"
                            CornerRadius="14"
                            Background="{Binding PushCardBackground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#221B1B26}"
                            BorderBrush="{Binding PushCardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#59FFFFFF}"
                            BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActivePushIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"
                                           Visibility="{Binding ActivePushHasImage, Converter={StaticResource BoolToVisInvert}}"/>
                                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,10,0" ClipToBounds="True"
                                        Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"
                                        Visibility="{Binding ActivePushHasImage, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding ActivePushImageSource}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding ActivePushTitle}" FontSize="15" FontWeight="SemiBold" MaxWidth="560" VerticalAlignment="Center"
                                           Foreground="{Binding PushCardForeground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActivePushSubtitle}" FontSize="11.5" MaxWidth="560" Margin="0,2,0,0"
                                       Foreground="{Binding PushCardSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ActivePushHasSubtitle, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ActivePushBody}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                       Foreground="{Binding PushCardSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       Visibility="{Binding ActivePushHasBody, Converter={StaticResource BoolToVis}}"/>
                            <ProgressBar Height="4" Maximum="1" Value="{Binding ActivePushProgress, Mode=OneWay}" Margin="0,8,0,0"
                                         Visibility="{Binding ActivePushHasProgress, Converter={StaticResource BoolToVis}}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="2" Background="#33FFFFFF"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <ItemsControl ItemsSource="{Binding ActivePushButtons}" Margin="0,8,0,0"
                                          Visibility="{Binding ActivePushHasButtons, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}" Padding="10,5" Margin="0,0,8,0" Click="PushButton_Click">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasPushInput, Converter={StaticResource BoolToVis}}">
                                <Grid Width="300" Height="28">
                                    <TextBox Text="{Binding PushInputValue, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                             VerticalContentAlignment="Center" Padding="7,0"
                                             Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                                             Foreground="{Binding PushCardForeground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                                    <TextBlock Text="{Binding PushInputPlaceholder}" FontSize="12" Margin="9,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55"
                                               Foreground="{Binding PushCardSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                               Visibility="{Binding PushInputHasText, Converter={StaticResource BoolToVisInvert}}"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Padding="12,5" Margin="8,0,0,0" Click="PushInputSubmit_Click">
                                    <TextBlock Text="{Binding PushInputSubmitLabel}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 媒体大卡片模板（Hero）：大封面背景 + 渐变遮罩 + 歌名/歌手/专辑叠加 -->
                    <Border x:Name="HeroCard" CornerRadius="18" Height="190" Margin="0,0,0,10" ClipToBounds="True" Cursor="Hand"
                            Visibility="{Binding ExpandedHeroCard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"
                                        AlignmentX="Center" AlignmentY="Center">
                                <ImageBrush.RelativeTransform>
                                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" CenterX="0.5" CenterY="0.5"/>
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Border.Background>
                        <Grid>
                            <!-- 无封面时的底色 / 有封面时轻微压暗，保证白色文字可读 -->
                            <Border Background="#B3101018"/>
                            <!-- 顶部轻微压暗 -->
                            <Border Background="#22000000"/>
                            <!-- 底部渐变遮罩 -->
                            <Border VerticalAlignment="Bottom" Height="128">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#B3000000" Offset="0.55"/>
                                        <GradientStop Color="#E6000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- 信息叠加 -->
                            <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,2,0,0"
                                           Foreground="White" Opacity="0.88" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Album}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="White" Opacity="0.66" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 大封面 + 标题/歌手/专辑 -->
                    <Grid x:Name="ArtTitleGrid" Visibility="{Binding ExpandedShowArtTitle, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BigArt" Width="72" Height="72" CornerRadius="18" Cursor="Hand"
                                BorderBrush="{Binding AccentBorderBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#336C5CE7}"
                                BorderThickness="1" RenderTransformOrigin="0.5,0.5"
                                Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BigArtScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                                       Visibility="{Binding Artwork, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisInvert}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Album}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- 进度条 -->
                    <Grid x:Name="ProgressGrid" Margin="0,10,0,0" Visibility="{Binding ExpandedShowProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ProgressSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Progress, Mode=OneWay}" IsEnabled="{Binding CanSeek}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PositionText}" FontSize="10"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            <TextBlock Text=" / " FontSize="10" Opacity="0.5"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            <TextBlock Text="{Binding DurationText}" FontSize="10"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 控制行 -->
                    <Grid x:Name="ControlsGrid" Margin="0,6,0,0" Visibility="{Binding ExpandedShowControls, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- 声音波纹：随音量起伏（展开控制行） -->
                                                        <StackPanel x:Name="WaveBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Visibility="{Binding HasWave, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <StackPanel x:Name="WaveBarsPanelExpanded" Orientation="Horizontal">
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar1" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar2" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar3" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar4" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar5" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar6" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                                <Border Width="2.6" Height="16" CornerRadius="1.3" VerticalAlignment="Center" Margin="0,0,2.2,0"
                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Border.RenderTransform><ScaleTransform x:Name="WaveBar7" ScaleY="0.16"/></Border.RenderTransform>
                                </Border>
                            </StackPanel>
                            <Grid x:Name="WaveSpectrumHostExpanded" Width="58" Height="18" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Grid x:Name="WaveRingHostExpanded" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Grid x:Name="WaveParticlesHostExpanded" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding PlayPauseCommand}">
                                <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <!-- 音量 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasVolumeControl, Converter={StaticResource BoolToVis}}">
                            <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="90" Minimum="0" Maximum="1"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 媒体来源选择（#3 多播放器切换：多个会话并存时显示，点击循环切换） -->
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Center" Padding="10,4" Margin="0,8,0,0"
                            Click="MediaSessionCycle_Click"
                            Visibility="{Binding MediaSessionPickerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                            <TextBlock Text="{Binding SelectedMediaSessionName}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                        </StackPanel>
                    </Button>

                    <!-- 歌词快捷操作：翻译开关 + 复制当前句 + 时间微调(#4) -->
                    <StackPanel x:Name="LyricQuickOpsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconButton}" Padding="9,3" Margin="0,0,8,0" Click="LyricSourceSwitch_Click"
                                Visibility="{Binding LyricSourcePickVisible, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Collapsed}"
                                ToolTip="{Binding LyricsSourceButtonHint}">
                            <TextBlock Text="{Binding LyricsSourceButtonText}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="9,3" Margin="0,0,8,0" Click="LyricTranslate_Click"
                                ToolTip="{Binding LyricTranslateHint}">
                            <TextBlock Text="{Binding LyricTranslateText}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="9,3" Click="CopyCurrentLyric_Click"
                                ToolTip="{Binding LyricCopyHint}">
                            <TextBlock Text="{Binding LyricCopyText}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="8,3" Margin="6,0,2,0" Click="LyricOffsetDown_Click"
                                ToolTip="{Binding LyricOffsetDownHint}">
                            <TextBlock Text="-0.5s" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="8,3" Margin="0,0,2,0" Click="LyricOffsetUp_Click"
                                ToolTip="{Binding LyricOffsetUpHint}">
                            <TextBlock Text="+0.5s" FontSize="11"/>
                        </Button>
                        <TextBlock Text="{Binding LyricOffsetText}" FontSize="10.5" VerticalAlignment="Center" Margin="2,0,0,0"
                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}" Opacity="0.85"/>
                    </StackPanel>

                    <!-- 歌词（无边框，干净排版） -->
                    <ScrollViewer x:Name="LyricsScroll" Height="180" Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Hidden"
                                  Visibility="{Binding ExpandedShowLyrics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <ItemsControl x:Name="LyricsList" ItemsSource="{Binding LyricLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LyricLineBorder}" HorizontalAlignment="Center">
                                        <StackPanel>
                                            <karaoke:KaraokeTextBlock
                                                KaraokeText="{Binding Text}"
                                                HighlightFraction="{Binding HighlightFraction}"
                                                Words="{Binding Words}"
                                                PositionSeconds="{Binding DataContext.KaraokePositionSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                IsPlaying="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"
                                                KaraokeSpeed="{Binding LyricKaraokeSpeed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}"
                                                HighlightBrush="{Binding ExpandedLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                BaseBrush="{Binding ExpandedLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                                Style="{DynamicResource LyricLineText}"/>
                                            <!-- 翻译行：随「翻译开关」显隐 -->
                                            <TextBlock Text="{Binding Translation}" FontSize="10.5" Margin="0,1,0,0" Opacity="0.72" HorizontalAlignment="Center"
                                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowTranslation}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasTranslation}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding LyricsStatus}" FontSize="12" HorizontalAlignment="Center" Margin="0,48,0,0" Opacity="0.65"
                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                               Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisInvert}}"/>

                    <!-- 快捷操作按钮（展开卡片底部一排，可自定义） -->
                    <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,2"
                                Visibility="{Binding HasQuickActions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding QuickActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,6,0"
                                            ToolTip="{Binding ToolTip}" Tag="{Binding Key}" Click="QuickAction_Click">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- 通知历史：展开卡片底部列表（#10），记录系统事件通知；点击条目可重新弹出，右侧可清空 -->
                    <StackPanel x:Name="NotificationHistoryPanel" Margin="0,6,0,2"
                                Visibility="{Binding NotificationHistoryVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="{Binding NotificationHistoryTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Button Click="ClearNotificationHistory_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2">
                                <TextBlock Text="{Binding NotificationHistoryClearText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11"
                                           Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NotificationHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="NotificationHistory_Click" Tag="{Binding}" Cursor="Hand" HorizontalAlignment="Stretch"
                                                Margin="0,1" Background="Transparent" BorderThickness="0" Padding="6,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="8,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{Binding ButtonHoverBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#22FFFFFF}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,8,0" ClipToBounds="True"
                                                        Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Opacity="0.6" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
