<Window x:Class="WinIslands.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinIslands.UI.Converters"
        xmlns:karaoke="clr-namespace:WinIslands.UI"
        Title="WinIslands"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="400"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.EdgeMode="Unspecified">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MenuGlass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>
        <conv:Mdl2GlyphFontConverter x:Key="GlyphFont"/>

        <!-- Icon button (transparent, hover highlight) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding ButtonHoverBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#22FFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin progress slider -->
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Height="4" CornerRadius="2"
                                    Background="{Binding SliderTrackBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#66FFFFFF}"/>
                            <Border x:Name="Fill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Width="12" Height="12" Margin="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="thumb" Fill="{Binding SliderThumbBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                         Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 逐句卡拉OK歌词：非当前句淡化，当前句大号醒目（20px），字号/透明度平滑过渡 -->
        <!-- 展开歌词每行样式：字号/行距/行高绑定窗口属性（设置页可调），当前句动画放大+高亮 -->
        <!-- 注意：此样式由 IslandWindow.xaml.cs 的 UpdateLyricLineStyle() 按用户设置动态重建并覆盖；XAML 默认值仅在启动瞬间兜底 -->
        <Style x:Key="LyricLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding LyricBaseFontSize, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=13}"/>
            <Setter Property="Foreground" Value="{Binding ExpandedLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{Binding LyricLineMargin, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=&quot;0,7&quot;}"/>
            <Setter Property="LineHeight" Value="{Binding LyricLineHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=24}"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="120">
                                <DoubleAnimation Storyboard.TargetProperty="FontSize" To="20" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="120">
                                <DoubleAnimation Storyboard.TargetProperty="FontSize" To="13" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{Binding ExpandedLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 歌词行容器：不加背景胶囊，当前句高亮只由卡拉OK文字渐变体现（避免双重高亮） -->
        <Style x:Key="LyricLineBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">
        <!--
            仿 iOS 灵动岛：窗口固定 400x400，仅内部卡片形变。
            紧凑 = 340x56 胶囊；展开 = 400x~370 卡片，向下生长。
            透明区域点击穿透（WPF 按渲染内容命中测试）。
        -->
        <Border x:Name="Card" Width="360" Height="72" CornerRadius="28"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                ClipToBounds="True"
                Background="{Binding CardBackground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#101018}"
                BorderBrush="{Binding CardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#33FFFFFF}"
                BorderThickness="1"
                AllowDrop="True"
                DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop"
                ContextMenuOpening="Card_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="IslandMenu">
                    <MenuItem x:Name="MenuCenterAlign" Header="居中对齐" Click="MenuCenterAlign_Click"/>
                    <MenuItem x:Name="MenuLock" Header="上锁" Click="MenuLock_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuOnlineLyrics" Header="在线歌词（免配置）" IsCheckable="True" Click="MenuOnlineLyrics_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- 智能透明度分层（1.2.1）：紧凑态透明、展开态更实。GlassLayer 用主题底色叠加，
                     展开时平滑升不透明度、收起时回落，配合封面取色（CoverTint）时自动归零不叠加。 -->
                <Border x:Name="GlassLayer" IsHitTestVisible="False" Opacity="0" ClipToBounds="True" CornerRadius="28"/>
                <Grid x:Name="ContentGrid" Margin="10,6,10,6" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ 胶囊行（始终可见）═══ -->
                <Grid x:Name="PillRow" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 上岛推送（第三方软件推送到灵动岛）：紧凑态即展示全部内容，尺寸自适应 -->
                    <!-- 上岛推送（第三方软件推送到灵动岛）：紧凑态单行显示（图标 + 标题 + 单行摘要），展开态展示完整详情 -->
                    <Border x:Name="CompactPushCard" Visibility="{Binding HasActivePush, Converter={StaticResource BoolToVis}}"
                            CornerRadius="14"
                            Background="{Binding PushCardBackground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#221B1B26}"
                            BorderBrush="{Binding PushCardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#59FFFFFF}"
                            BorderThickness="1"
                            MaxWidth="520"
                            Padding="12,7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CompactPushScale" ScaleX="0.94" ScaleY="0.94"/>
                        </Border.RenderTransform>
                        <!-- 单行：图标 + 标题 + 摘要（副标题优先，其次正文），过长省略；不撑宽、不撑高灵动岛 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,8,0" ClipToBounds="True"
                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                                <Grid>
                                    <TextBlock Text="{Binding ActivePushIcon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ActivePushHasImage, Converter={StaticResource BoolToVisInvert}}"/>
                                    <Image Source="{Binding ActivePushImageSource}" Stretch="UniformToFill"
                                           Visibility="{Binding ActivePushHasImage, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ActivePushTitle}" FontSize="13" FontWeight="SemiBold" MaxWidth="240" VerticalAlignment="Center"
                                       Foreground="{Binding PushCardForeground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActivePushSummary}" FontSize="11.5" Margin="8,0,0,0" MaxWidth="200" VerticalAlignment="Center"
                                       Foreground="{Binding PushCardSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ActivePushHasSummary, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 按「组件顺序」动态渲染：歌曲信息 / 时间 / 天气（播放时含歌曲，空闲时去掉） -->
                    <ItemsControl ItemsSource="{Binding CompactItems}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate x:Key="TimeItem">
                                <TextBlock Text="{Binding DataContext.ClockText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="{Binding DataContext.WidgetTimeFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="WeatherItem">
                                <TextBlock Text="{Binding DataContext.WeatherText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DataContext.WeatherDetailText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="DiskItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.DiskText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="DateItem">
                                <TextBlock Text="{Binding DataContext.DateText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="CpuItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="GpuItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="MicItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.MicText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="CamItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.CamText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="RamItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="NetItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.NetText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.NetTextUp, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <Polyline Points="{Binding DataContext.NetCurvePoints, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"
                                              StrokeThickness="1.5" Width="64" Height="14" Stretch="None" Margin="6,0,0,0"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="BatteryItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.BatteryText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="VolumeItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.VolumeText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="CapsLockItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.CapsLockText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="ClipboardItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.ClipboardSummary, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="TodoItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.TodoSummary, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="InputMethodItem">
                                <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto" MinWidth="0" Padding="6,3" Margin="0,0,10,0"
                                        Click="InputMethodItem_Click"
                                        ToolTip="{Binding DataContext.InputMethodHint, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                        <TextBlock Text="{Binding DataContext.InputMethodText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                            <DataTemplate x:Key="QuickTogglesItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                            ToolTip="{Binding DataContext.QuickTogglesHint, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto" MinWidth="0" Padding="6,3" Margin="0,0,4,0" Tag="wifi" Click="QuickToggle_Click">
                                        <TextBlock Text="{Binding DataContext.QuickWifiText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto" MinWidth="0" Padding="6,3" Margin="0,0,4,0" Tag="bluetooth" Click="QuickToggle_Click">
                                        <TextBlock Text="{Binding DataContext.QuickBtText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto" MinWidth="0" Padding="6,3" Margin="0,0,4,0" Tag="night" Click="QuickToggle_Click">
                                        <TextBlock Text="{Binding DataContext.QuickNightText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto" MinWidth="0" Padding="6,3" Margin="0,0,0,0" Tag="mute" Click="QuickToggle_Click">
