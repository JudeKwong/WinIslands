                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.Artwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisInvert}}"/>
                                        </Grid>
                                    </Border>
                                    <!-- 多行模式（默认）：歌名 / 歌手 / 歌词 / 进度条 -->
                                    <StackPanel x:Name="MultiLineInfo" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid MaxWidth="220" ClipToBounds="True">
                                            <TextBlock Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                       karaoke:Marquee.IsEnabled="{Binding MarqueeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                            <!-- 播放来源徽标（如 Spotify / 网易云音乐），无来源名时隐藏 -->
