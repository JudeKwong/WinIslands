                                                <TextBlock Text="{Binding DataContext.SourceDetail, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9" MaxWidth="70" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DataContext.Artist, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Margin="0,1,0,0"
