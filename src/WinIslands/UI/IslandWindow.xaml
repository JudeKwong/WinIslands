                                        BorderBrush="{Binding PushCardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#59FFFFFF}"
                                        BorderThickness="1" Cursor="SizeAll"
                                        ToolTip="{Binding DataContext.FileTransferToolTip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        PreviewMouseLeftButtonDown="FileTransferItem_Down"
                                        PreviewMouseMove="FileTransferItem_Move"
                                        PreviewMouseLeftButtonUp="FileTransferItem_Up">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                        <Grid MaxWidth="180" ClipToBounds="True">
                                            <TextBlock Text="{Binding DataContext.FileTransferSummary, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" karaoke:Marquee.IsEnabled="{Binding MarqueeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                                        </Grid>
                                        <Button Style="{StaticResource IconButton}" Padding="1,0" Margin="5,0,2,0" VerticalAlignment="Center" Click="FileTransferClear_Click"
                                                ToolTip="{Binding DataContext.FileTransferRemoveTip, RelativeSource={RelativeSource AncestorType=Window}}">
