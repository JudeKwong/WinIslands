                                                   TextTrimming="CharacterEllipsis"/>
                                        <Grid MaxWidth="300" ClipToBounds="True">
                                            <karaoke:KaraokeTextBlock
                                                KaraokeText="{Binding DataContext.CurrentLyricText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                HighlightFraction="{Binding DataContext.CompactHighlightFraction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Words="{Binding DataContext.CurrentLyricWords, RelativeSource={RelativeSource AncestorType=Window}}"
                                                PositionSeconds="{Binding DataContext.KaraokePositionSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                IsPlaying="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                                                KaraokeSpeed="{Binding LyricKaraokeSpeed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}"
                                                HighlightBrush="{Binding CompactLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                BaseBrush="{Binding CompactLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#80FFFFFF}"
                                                karaoke:Marquee.IsEnabled="{Binding MarqueeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                FontSize="11.5" Margin="0,2,0,0" TextAlignment="Left" FontWeight="SemiBold" Opacity="0.95"/>
                                        </Grid>
                                        <ProgressBar Height="3" Maximum="1"
                                                     Value="{Binding DataContext.Progress, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Margin="0,4,0,0">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border CornerRadius="2" Background="#33FFFFFF"/>
                                                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                                Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </StackPanel>
                                    <!-- 单行模式：封面 + 歌名 - 歌手（一行） -->
                                    <StackPanel x:Name="SingleLineInfo" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Grid MaxWidth="140" ClipToBounds="True">
                                        <TextBlock Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                   karaoke:Marquee.IsEnabled="{Binding MarqueeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                        <TextBlock Text="{Binding DataContext.Artist, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Margin="6,0,0,0"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="100" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#x00B7;" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                                   Visibility="{Binding DataContext.HasLyrics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Grid MaxWidth="300" ClipToBounds="True"
                                        Visibility="{Binding DataContext.HasLyrics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <karaoke:KaraokeTextBlock
                                            KaraokeText="{Binding DataContext.CurrentLyricText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HighlightFraction="{Binding DataContext.CompactHighlightFraction, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Words="{Binding DataContext.CurrentLyricWords, RelativeSource={RelativeSource AncestorType=Window}}"
                                            PositionSeconds="{Binding DataContext.KaraokePositionSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsPlaying="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                                            KaraokeSpeed="{Binding LyricKaraokeSpeed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}"
                                            HighlightBrush="{Binding CompactLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                            BaseBrush="{Binding CompactLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#A0FFFFFF}"
                                            FontSize="11" Margin="8,0,0,0"
                                            TextAlignment="Left" FontWeight="SemiBold"
                                            karaoke:Marquee.IsEnabled="{Binding MarqueeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                            VerticalAlignment="Center"/>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SingleLineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="MultiLineInfo" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="SingleLineInfo" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                <ContentControl Focusable="False" Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SongItem}"/>
