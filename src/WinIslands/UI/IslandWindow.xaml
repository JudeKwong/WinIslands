                                                <DataTrigger Binding="{Binding Kind}" Value="VolumeTemp">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource VolumeTempItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Usage">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource UsageItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="FileCopy">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource FileCopyItem}"/>
