<Window x:Class="WinIslands.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinIslands.UI.Converters"
        xmlns:karaoke="clr-namespace:WinIslands.UI"
        Title="WinIslands"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="496" Height="190"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="Linear"
        RenderOptions.EdgeMode="Unspecified">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MenuGlass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>
        <conv:Mdl2GlyphFontConverter x:Key="GlyphFont"/>

        <!-- 通知胶囊按钮：与通知条同款 20px 高、10px 圆角 -->
        <Style x:Key="NoticeCapsuleButton" TargetType="Button">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NoticeButtonBg" CornerRadius="10" Background="#232323"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoticeButtonBg" Property="Background" Value="#38383C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoticeButtonBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通知详情操作按钮：与通知条按钮同款 20px 胶囊 -->
        <Style x:Key="NoticeDetailButton" TargetType="Button">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NoticeDetailBg" CornerRadius="10" Background="#232323"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoticeDetailBg" Property="Background" Value="#38383C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoticeDetailBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button (transparent, hover highlight) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding ButtonHoverBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#22FFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin progress slider -->
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Height="4" CornerRadius="2"
                                    Background="{Binding SliderTrackBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#66FFFFFF}"/>
                            <Border x:Name="Fill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Width="12" Height="12" Margin="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="thumb" Fill="{Binding SliderThumbBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                         Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 逐句卡拉OK歌词：非当前句淡化，当前句醒目；展开态固定使用参考项目的紧凑 10/12px 字号。 -->
        <!-- 展开歌词每行样式：字号/行距/行高绑定窗口属性（固定参考布局），当前句动画放大+高亮。 -->
        <!-- 注意：此样式由 UpdateLyricLineStyle() 按参考字号动态重建；XAML 默认值仅在启动瞬间兜底 -->
                <Style x:Key="LyricLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding LyricBaseFontSize, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=10}"/>
            <Setter Property="Foreground" Value="{Binding ExpandedLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="{Binding LyricLineMargin, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=&quot;0,6&quot;}"/>
            <Setter Property="LineHeight" Value="{Binding LyricLineHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=15}"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="karaoke:LyricEmphasis.TargetScale" Value="1.2"/>
            <Setter Property="karaoke:LyricEmphasis.DurationMs" Value="240"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <!-- 2.3.2: opacity is driven by the LyricEmphasis normalized-progress spring (sync with scale);
                         the fixed-duration fade Storyboards were removed so the text never pops in separately -->
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{Binding ExpandedLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                    <Setter Property="karaoke:LyricEmphasis.IsCurrent" Value="True"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LyricLineBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">
        <!--
            仿 iOS 灵动岛：透明宿主窗口提供固定画布，仅内部卡片形变。
            紧凑 = 340x56 胶囊；展开态统一为参考项目的 419×140，不再按内容向下生长。
            透明区域点击穿透（WPF 按渲染内容命中测试）。
        -->
        <Border x:Name="Card" Width="360" Height="72" CornerRadius="28"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                ClipToBounds="True"
                Background="{Binding CardBackground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#101018}"
                BorderBrush="{Binding CardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#33FFFFFF}"
                BorderThickness="1"
                AllowDrop="True" PreviewMouseWheel="Card_PreviewMouseWheel" PreviewKeyDown="Card_PreviewKeyDown"
                DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop"
                ContextMenuOpening="Card_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="IslandMenu">
                    <MenuItem x:Name="MenuCenterAlign" Header="居中对齐" Click="MenuCenterAlign_Click"/>
                    <MenuItem x:Name="MenuLock" Header="上锁" Click="MenuLock_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuOnlineLyrics" Header="在线歌词（免配置）" IsCheckable="True" Click="MenuOnlineLyrics_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- 智能透明度分层（1.2.1）：紧凑态透明、展开态更实。GlassLayer 用主题底色叠加，
                     展开时平滑升不透明度、收起时回落，配合封面取色（CoverTint）时自动归零不叠加。 -->
                <Border x:Name="GlassLayer" IsHitTestVisible="False" Opacity="0" ClipToBounds="True" CornerRadius="28"/>
                <Grid x:Name="ContentGrid" Margin="10,6,10,6" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ 胶囊行（始终可见）═══ -->
                <Grid x:Name="PillRow" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PillRowScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PillRowTranslate" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 上岛通知：统一 334×44 通知条；微信/QQ 用应用图标 + 查看/关闭，普通通知用铃铛 + 关闭 -->
                    <Border x:Name="CompactPushCard" Grid.Column="0" Width="334" Height="44"
                            Margin="-10,-6,-10,-6" HorizontalAlignment="Left" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5" ClipToBounds="False"
                            Visibility="{Binding HasActivePush, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CompactPushScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CompactPushTranslate" X="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Canvas Width="334" Height="44" ClipToBounds="True">
                            <!-- 微信/QQ：左侧应用圆标 + 双行文字 + 查看/关闭 -->
                            <Canvas Width="334" Height="44"
                                    Visibility="{Binding ActivePushIsMessenger, Converter={StaticResource BoolToVis}}">
                                <!-- 微信双气泡图标（参考实现 22×22）+ QQ 客户端图标 -->
                                <Canvas Canvas.Left="11" Canvas.Top="11.5" Width="22" Height="22">
                                    <Canvas Visibility="{Binding ActivePushIsWeChat, Converter={StaticResource BoolToVis}}">
                                        <Rectangle Canvas.Left="1" Canvas.Top="3.5" Width="14" Height="11" RadiusX="5.5" RadiusY="5.5" Fill="#46CB7B"/>
                                        <Path Fill="#46CB7B" Data="M 3,11 L 3,16.6 L 8,12.4 Z"/>
                                        <Ellipse Canvas.Left="4.1" Canvas.Top="6.6" Width="1.8" Height="1.8" Fill="#181818"/>
                                        <Ellipse Canvas.Left="9.1" Canvas.Top="6.6" Width="1.8" Height="1.8" Fill="#181818"/>
                                        <Rectangle Canvas.Left="9" Canvas.Top="8.5" Width="13" Height="10" RadiusX="5" RadiusY="5" Fill="#91EBA5"/>
                                        <Path Fill="#91EBA5" Data="M 16,16.5 L 20,20.5 L 19,15.5 Z"/>
                                        <Ellipse Canvas.Left="12.2" Canvas.Top="10.7" Width="1.6" Height="1.6" Fill="#181818"/>
                                        <Ellipse Canvas.Left="17.2" Canvas.Top="10.7" Width="1.6" Height="1.6" Fill="#181818"/>
                                    </Canvas>
                                    <Image Canvas.Left="1.5" Canvas.Top="1" Width="19" Height="19" Source="/Assets/qq-client.png" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ActivePushIsQq, Converter={StaticResource BoolToVis}}"/>
                                </Canvas>
                                <Ellipse Canvas.Left="28.4" Canvas.Top="11.4" Width="5.2" Height="5.2" Fill="#FF4848"
                                         Visibility="{Binding ActivePushHasRedDot, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Canvas.Left="44" Canvas.Top="4" Width="154" Height="20"
                                           Text="{Binding ActivePushTitle}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Canvas.Left="44" Canvas.Top="22" Width="154" Height="16"
                                           Text="{Binding ActivePushSummary}" FontSize="10.5" Foreground="#B2B2BA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ActivePushHasSummary, Converter={StaticResource BoolToVis}}"/>
                                <Button Canvas.Left="206" Canvas.Top="12" Width="52" Style="{StaticResource NoticeCapsuleButton}"
                                        Click="ViewPushMessenger_Click">
                                    <TextBlock Text="查看" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </Button>
                                <Button Canvas.Left="265" Canvas.Top="12" Width="52" Style="{StaticResource NoticeCapsuleButton}"
                                        Click="DismissPush_Click">
                                    <TextBlock Text="关闭" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </Button>
                            </Canvas>
                            <!-- 普通通知：双行文字 + 右侧铃铛红点 + 关闭 -->
                            <Canvas Width="334" Height="44"
                                    Visibility="{Binding ActivePushIsMessenger, Converter={StaticResource BoolToVisInvert}}">
                                <TextBlock Canvas.Left="16" Canvas.Top="4" Width="198" Height="20"
                                           Text="{Binding ActivePushTitle}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Canvas.Left="16" Canvas.Top="22" Width="198" Height="16"
                                           Text="{Binding ActivePushSummary}" FontSize="10.5" Foreground="#B2B2BA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ActivePushHasSummary, Converter={StaticResource BoolToVis}}"/>
                                <Button Canvas.Left="226" Canvas.Top="12" Width="60" Style="{StaticResource NoticeCapsuleButton}"
                                        Click="DismissPush_Click">
                                    <TextBlock Text="关闭" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </Button>
                                <!-- 参考实现的矢量铃铛：0.95s 衰减摆动，由代码启动 -->
                                <Canvas Canvas.Left="300" Canvas.Top="12" Width="20" Height="20" RenderTransformOrigin="0.5,0.25">
                                    <Canvas.RenderTransform>
                                        <RotateTransform x:Name="CompactNoticeBellRotate"/>
                                    </Canvas.RenderTransform>
                                    <Path Fill="#B2B2BA" Data="M 6.6,9.4 A 3.4,3.4 0 0 1 13.4,9.4 L 13.6,12.4 L 14.6,13.2 L 5.4,13.2 L 6.4,12.4 Z"/>
                                    <Ellipse Canvas.Left="8.8" Canvas.Top="13.4" Width="2.4" Height="2.4" Fill="#B2B2BA"/>
                                </Canvas>
                                <Ellipse Canvas.Left="312" Canvas.Top="15.5" Width="4" Height="4" Fill="#FF4848"/>
                            </Canvas>
                        </Canvas>
                    </Border>

                    <!-- 按「组件顺序」动态渲染：歌曲信息 / 时间 / 天气（播放时含歌曲，空闲时去掉） -->
                    <!-- 微信/QQ 未读图标栈（岛仔同款：图标 + 红点，点击切回窗口） -->
                    <ItemsControl ItemsSource="{Binding MessengerUnreads}" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Visibility="{Binding HasMessengerUnreads, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="MessengerUnread_Click" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,4,0"
                                        ToolTip="{Binding SourceName}">
                                    <Grid Width="24" Height="24">
                                        <Border CornerRadius="12" Background="{Binding AccentBrush}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="12"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Ellipse Width="7" Height="7" Fill="#FF4848"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding CompactItems}" VerticalAlignment="Center"
                                  Visibility="{Binding HasActivePush, Converter={StaticResource BoolToVisInvert}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate x:Key="TimeItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <!-- 岛仔同款：细描边圆环 + 粗体时间 -->
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                            BorderBrush="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#7955B8}"
                                            BorderThickness="1.5"
                                            Visibility="{Binding IsDaozai, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#7955B8}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DataContext.ClockText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontSize="{Binding DataContext.WidgetTimeFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="WeatherItem">
                                <TextBlock Text="{Binding DataContext.WeatherText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DataContext.WeatherDetailText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="PluginItem">
                                <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="PluginItem_MouseLeftButtonUp"
                                        ToolTip="{Binding ToolTip}" Loaded="PluginItem_Loaded">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Image Source="{Binding Image}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"
                                               Visibility="{Binding Image, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Visibility="{Binding Image, Converter={StaticResource NullToVisInvert}}"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                        <Ellipse Width="5" Height="5" Fill="{Binding AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"
                                                 Visibility="{Binding AccentBrush, Converter={StaticResource NullToVis}}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" FontSize="10" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" Width="80" HorizontalAlignment="Left"
                                                         Margin="0,2,0,0" Visibility="{Binding Progress, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate x:Key="DiskItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.DiskText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="DateItem">
                                <TextBlock Text="{Binding DataContext.DateText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="CpuItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="GpuItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{Binding Icon, Converter={StaticResource GlyphFont}}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </StackPanel>
                            </DataTemplate>
