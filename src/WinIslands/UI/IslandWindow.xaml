                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate x:Key="SongItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Tag="SongCover" Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0"
                                            Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                                        <Grid>
                                            <Image Source="{Binding DataContext.Artwork, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"
                                                   Visibility="{Binding DataContext.Artwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}"/>
