                                <Button Style="{StaticResource IconButton}" Padding="12,5" Margin="8,0,0,0" Click="PushInputSubmit_Click">
                                    <TextBlock Text="{Binding PushInputSubmitLabel}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="PageTitleHost">
                        <TextBlock x:Name="ActivePageTitleText" Text="{Binding ActivePageTitle}" FontSize="12.5" FontWeight="Bold" Margin="2,0,0,0"
                                   Foreground="{Binding ActivePageAccentBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="{Binding IsDaozai, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMusicPage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="ActivePageTitleTranslate" X="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="PageTransitionTitleSnapshot" FontSize="12.5" FontWeight="Bold" Margin="2,0,0,0"
                                   Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                                   Foreground="{Binding ActivePageAccentBrush}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="PageTransitionTitleTranslate" X="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <!-- xiaotang-daozai page transition: all pages overlay in one cell. -->
                    <Grid x:Name="DaozaiPageHost" Width="399" Height="126" ClipToBounds="True">
                    <StackPanel x:Name="MusicPagePanel" Width="399" Height="126"
                                Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="MusicPageTranslate" X="0"/>
                        </StackPanel.RenderTransform>
                        <!-- 页面内容按参考实现的 399×126 排版，由 DaozaiPageHost 的 LayoutTransform 统一放大。 -->
                        <Grid Width="399" Height="126">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="78"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="189"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="39"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.ColumnSpan="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="186"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HeroCard" Grid.Column="1" Width="177" Height="44" CornerRadius="10"
                                        Margin="0,23,0,15" HorizontalAlignment="Left" ClipToBounds="True" Cursor="Hand"
                                        Visibility="{Binding ExpandedHeroCard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"
                                                    AlignmentX="Center" AlignmentY="Center"/>
                                    </Border.Background>
                                    <Grid>
                                        <Border Background="#B3101018"/>
                                        <StackPanel Margin="50,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" karaoke:FadeOnTextChange.Enabled="True"
                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="10.5" Margin="0,1,0,0" karaoke:FadeOnTextChange.Enabled="True"
                                                       Foreground="White" Opacity="0.84" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="ArtTitleGrid" Grid.Column="1" Width="177" Height="44" Margin="0,23,0,15" HorizontalAlignment="Left"
                                      Visibility="{Binding ExpandedShowArtTitle, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BigArt" Width="44" Height="44" CornerRadius="10" Cursor="Hand"
                                            BorderBrush="{Binding AccentBorderBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#336C5CE7}"
                                            BorderThickness="1" RenderTransformOrigin="0.5,0.5"
                                            Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="BigArtScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding Artwork, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Artwork, Converter={StaticResource NullToVisInvert}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" karaoke:FadeOnTextChange.Enabled="True" karaoke:FadeOnTextChange.SlideUp="True"
                                                   Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="10.5" Margin="0,1,0,0" karaoke:FadeOnTextChange.Enabled="True" karaoke:FadeOnTextChange.SlideUp="True"
                                                   Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Column="2" Width="1" Height="66" Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#232325"/>

                                <ScrollViewer x:Name="LyricsScroll" Grid.Column="3" Width="136" Height="74" Margin="9,28,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              VerticalScrollBarVisibility="Hidden"
                                              Visibility="{Binding ExpandedShowLyrics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="0.12"/>
                                            <GradientStop Color="#FF000000" Offset="0.88"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <ItemsControl x:Name="LyricsList" ItemsSource="{Binding LyricLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource LyricLineBorder}" HorizontalAlignment="Center">
                                                    <StackPanel>
                                                        <karaoke:KaraokeTextBlock
                                                            KaraokeText="{Binding Text}"
                                                            HighlightFraction="{Binding HighlightFraction}"
                                                            Words="{Binding Words}"
                                                            PositionSeconds="{Binding DataContext.KaraokePositionSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            IsPlaying="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"
                                                            KaraokeSpeed="{Binding LyricKaraokeSpeed, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}"
                                                            HighlightBrush="{Binding ExpandedLyricHighlightBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                            BaseBrush="{Binding ExpandedLyricBaseBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                                            Style="{DynamicResource LyricLineText}"/>
                                                        <TextBlock Text="{Binding Translation}" FontSize="{Binding LyricTranslationFontSize, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=8}" Margin="0,1,0,0" Opacity="0.7" HorizontalAlignment="Center"
                                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowTranslation}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasTranslation}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Column="3" Text="{Binding LyricsStatus}" FontSize="{Binding LyricsStatusFontSize, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=10}" Width="136" Height="74" Margin="9,28,0,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center" Opacity="0.65"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                           Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisInvert}}"/>
                            </Grid>

                            <Grid x:Name="ProgressGrid" Grid.Row="1" Grid.ColumnSpan="5" Width="176" Margin="34,0,0,0"
                                  Visibility="{Binding ExpandedShowProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="10"/>
                                </Grid.RowDefinitions>
                                <Slider x:Name="ProgressSlider" Grid.Row="0" Style="{StaticResource ThinSlider}" Height="8" VerticalAlignment="Top" Margin="0,-1,0,0"
                                        Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsEnabled="{Binding CanSeek}"/>
                                <Grid Grid.Row="1">
                                    <TextBlock Text="{Binding PositionText}" FontSize="9" HorizontalAlignment="Left"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                    <TextBlock Text="{Binding DurationText}" FontSize="9" HorizontalAlignment="Right"
                                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ControlsGrid" Grid.Row="2" Grid.ColumnSpan="5" Height="24"
                                  Visibility="{Binding ExpandedShowControls, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="LyricQuickOpsPanel" Orientation="Horizontal" Height="24"
                                                Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,3,0" Click="LyricSourceSwitch_Click"
                                                Visibility="{Binding LyricSourcePickVisible, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Collapsed}"
                                                ToolTip="{Binding LyricsSourceButtonHint}">
                                            <TextBlock Text="{Binding LyricsSourceButtonText}" FontSize="8"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,3,0" Click="LyricTranslate_Click"
                                                ToolTip="{Binding LyricTranslateHint}">
                                            <TextBlock Text="{Binding LyricTranslateText}" FontSize="8"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,3,0" Click="CopyCurrentLyric_Click"
                                                ToolTip="{Binding LyricCopyHint}">
                                            <TextBlock Text="{Binding LyricCopyText}" FontSize="8"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,1,0" Click="LyricOffsetDown_Click"
                                                ToolTip="{Binding LyricOffsetDownHint}">
                                            <TextBlock Text="-" FontSize="9"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,2,0" Click="LyricOffsetUp_Click"
                                                ToolTip="{Binding LyricOffsetUpHint}">
                                            <TextBlock Text="+" FontSize="9"/>
                                        </Button>
                                        <TextBlock Text="{Binding LyricOffsetText}" FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}" Opacity="0.8"/>
                                    </StackPanel>
                                    <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal" Height="24"
                                                Visibility="{Binding HasQuickActions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding QuickActions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,3,0"
                                                            ToolTip="{Binding ToolTip}" Tag="{Binding Key}" Click="QuickAction_Click">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,8,0" Click="MediaSessionCycle_Click"
                                            ToolTip="{Binding SelectedMediaSessionName}"
                                            Visibility="{Binding MediaSessionPickerVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                    <StackPanel x:Name="WaveBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                                Visibility="{Binding HasWave, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel x:Name="WaveBarsPanelExpanded" Orientation="Horizontal">
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar1" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar2" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar3" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar4" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar5" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar6" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                            <Border Width="2" Height="10" CornerRadius="1" VerticalAlignment="Center"
                                                    Background="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                <Border.RenderTransform><ScaleTransform x:Name="WaveBar7" ScaleY="0.16"/></Border.RenderTransform>
                                            </Border>
                                        </StackPanel>
                                        <Grid x:Name="WaveSpectrumHostExpanded" Width="24" Height="12" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Grid x:Name="WaveRingHostExpanded" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <Grid x:Name="WaveParticlesHostExpanded" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}">
                                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="24" Padding="0" Command="{Binding PlayPauseCommand}">
                                        <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}">
                                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding HasVolumeControl, Converter={StaticResource BoolToVis}}">
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="52" Height="16" Minimum="0" Maximum="1"
                                            Value="{Binding Volume, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- 岛仔功能页：专注（固定 419×140 展开卡的一部分，底部为控制按钮） -->
                    <StackPanel x:Name="FocusPagePanel" Width="399" Height="86"
                                Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FocusPageTranslate" X="0"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="399" Height="86">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" Margin="16,2,0,0" CornerRadius="26"
                                        Background="#1A0E10" BorderBrush="#FD685C" BorderThickness="5">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FD685C"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PomodoroClockText}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="10" Foreground="#8E8E99" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource IconButton}" Command="{Binding PomodoroWorkCommand}" Content="专注"
                                        Width="54" Height="24" Padding="0" Margin="0,0,5,0" FontSize="10" Background="#2A2A2E"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding PomodoroBreakCommand}" Content="休息"
                                        Width="54" Height="24" Padding="0" Margin="0,0,5,0" FontSize="10" Background="#2A2A2E"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding PomodoroToggleCommand}" Content="暂停/继续"
                                        Width="70" Height="24" Padding="0" Margin="0,0,5,0" FontSize="10" Background="#2A2A2E"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding PomodoroStopCommand}" Content="停止"
                                        Width="54" Height="24" Padding="0" FontSize="10" Background="#2A2A2E"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 岛仔功能页：待办（固定 419×140，列表最多显示三行，其余可滚动） -->
                    <StackPanel x:Name="TodoPagePanel" Width="399" Height="86" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="TodoPageTranslate" X="0"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="399" Height="86">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="66"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,0,16,0">
                                <TextBlock Text="{Binding TodoSummary}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="已完成" FontSize="9.5" Foreground="#8E8E99" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Height="66" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding TodoItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="20" CornerRadius="7" Background="#242427" Padding="8,0" Margin="16,0,16,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Done, Mode=OneWay}" IsHitTestVisible="False"
                                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#E8E8ED"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>

                    <!-- 岛仔功能页：日程（固定 419×140，列表最多显示三行，其余可滚动） -->
                    <StackPanel x:Name="SchedulePagePanel" Width="399" Height="86" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="SchedulePageTranslate" X="0"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="399" Height="86">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="68"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ScheduleSummary}" FontSize="13" FontWeight="Bold"
                                       Foreground="White" Margin="16,0,16,0"/>
                            <ScrollViewer Grid.Row="1" Height="68" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding ScheduleItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="20" CornerRadius="7" Background="#242427" Padding="8,0" Margin="16,0,16,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding When, StringFormat={}{0:HH:mm}}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#3EACF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10" Foreground="#E8E8ED"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                    </Grid>
                    <!-- 岛仔页码豆：真实页面导航 -->
                    <ItemsControl x:Name="PageDots" ItemsSource="{Binding Pages}" HorizontalAlignment="Center" Margin="0,1,0,0"
                                  Visibility="{Binding IsDaozai, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="PageDot_Click" Cursor="Hand" Background="Transparent"
                                        BorderThickness="0" Padding="0" Height="10">
                                    <Border x:Name="Dot" Width="4" Height="4" CornerRadius="2"
                                            Background="{Binding DataContext.DaozaiDotBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=#5C5C60}"/>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Dot" Property="Background" Value="White"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Button Style="{StaticResource IconButton}" Command="{Binding PrevPageCommand}" Focusable="False"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="28" Height="28" Opacity="0.8"
                        Visibility="{Binding PageNavVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Opacity="0.8"
                        Visibility="{Binding PageNavVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                </Grid>
            </Grid>
        </Border>
        <!-- xiaotang-daozai reference copy toast: 2.4s, 160ms fade-in, 300ms fade-out. -->
        <Border x:Name="CopyToast" Height="22" MaxWidth="310" Padding="13,0"
                CornerRadius="11" Background="#2C2C30"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Opacity="0" IsHitTestVisible="False"
                Visibility="{Binding HasCopyToast, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CopyToastTranslate" Y="64"/>
            </Border.RenderTransform>
            <TextBlock Text="{Binding CopyToastText}" FontSize="11.5" Foreground="White"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
