<Window x:Class="WinIslands.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinIslands.UI"
        Title="欢迎使用 WinIslands" Width="620" Height="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Foreground="{DynamicResource OnbTextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="OnbTextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="OnbMutedBrush" Color="#A7A7B0"/>
        <SolidColorBrush x:Key="OnbAccentBrush" Color="#7955B8"/>
        <SolidColorBrush x:Key="OnbCardBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="OnbCardBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="OnbControlBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="OnbControlBorderBrush" Color="#34FFFFFF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnbTextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnbTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource OnbControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OnbControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.62"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="OnbPrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource OnbAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OnbAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OnbTextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="OnbTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OnbMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource OnbMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="24" ClipToBounds="True"
            BorderBrush="{DynamicResource OnbCardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <ui:FrostedGlassLayer x:Name="Frosted" CornerRadius="24" Intensity="1"/>

            <Grid Margin="30,24,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="13"
                            Background="{DynamicResource OnbAccentBrush}" VerticalAlignment="Top">
                        <TextBlock Text="W" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                        <TextBlock Text="WinIslands" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStep" Text="第 1 步，共 3 步" FontSize="11.5"
                                   Foreground="{DynamicResource OnbMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="34" Padding="0" BorderThickness="0"
                            Background="Transparent" ToolTip="关闭" Click="Close_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="StepWelcome" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource OnbTitle}" Text="把音乐和通知，&#x0a;收进一个灵动岛"/>
                        <TextBlock Style="{StaticResource OnbMuted}" Margin="0,12,0,0"
                                   Text="WinIslands 会在桌面顶部显示当前歌曲、歌词、系统状态和通知。鼠标悬停即可展开，移开后自动收起。"/>
                        <Border CornerRadius="16" Background="{DynamicResource OnbCardBrush}"
                                BorderBrush="{DynamicResource OnbCardBorderBrush}" BorderThickness="1"
                                Padding="16,13" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="接下来会确认媒体来源、歌词和通知，大约需要 1 分钟。" FontSize="12.5"/>
                                <TextBlock Style="{StaticResource OnbMuted}" Margin="0,6,0,0"
                                           Text="所有检查都只在本机运行，不会上传歌曲、通知或账号信息。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="StepMedia" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OnbTitle}" Text="选择媒体来源"/>
                        <TextBlock Style="{StaticResource OnbMuted}" Margin="0,8,0,10"
                                   Text="默认会读取 Windows 全局媒体会话（SMTC）。Cider 用户可启用本地接口，获得更完整的 Apple Music 信息。"/>
                        <Border CornerRadius="16" Background="{DynamicResource OnbCardBrush}"
                                BorderBrush="{DynamicResource OnbCardBorderBrush}" BorderThickness="1"
                                Padding="18,8,18,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkCider" Content="启用 Cider 本地接口（Apple Music）"/>
                                <CheckBox x:Name="ChkOnlineLyrics" Content="允许在线歌词（本地歌词缺失时使用）"/>
                                <CheckBox x:Name="ChkNotifications" Content="在灵动岛上显示系统通知"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource OnbMuted}" Margin="2,10,2,0"
                                   Text="这些选项之后都可以在“设置 → 媒体 / 歌词 / 通知”中修改。"/>
                    </StackPanel>

                    <Grid x:Name="StepCheck" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource OnbTitle}" Text="检查媒体连接"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource OnbMuted}" Margin="0,8,0,10"
                                   Text="先打开播放器并播放一首歌，然后运行检查。未检测到播放器也可以先完成设置。"/>
                        <Border Grid.Row="2" CornerRadius="16" Background="{DynamicResource OnbCardBrush}"
                                BorderBrush="{DynamicResource OnbCardBorderBrush}" BorderThickness="1"
                                Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtCheckStatus" Text="尚未检查" FontSize="12.5"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCheck" Grid.Column="1" Content="开始检查"
                                            Click="Check_Click" Padding="14,6"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtCheckResult" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{DynamicResource OnbMutedBrush}"
                                               Text="检查结果会显示在这里。"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBack" Content="上一步" Click="Back_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnSkip" Grid.Column="2" Content="稍后设置" Click="Skip_Click"
                            Background="Transparent" BorderThickness="0" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNext" Grid.Column="3" Style="{StaticResource OnbPrimaryButton}"
                            Content="下一步" Click="Next_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
