<Window x:Class="WinIslands.UI.MediaSourceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinIslands.UI"
        Title="媒体源检查" Width="660" Height="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource CheckTextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="CheckTextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="CheckMutedBrush" Color="#A7A7B0"/>
        <SolidColorBrush x:Key="CheckAccentBrush" Color="#7955B8"/>
        <SolidColorBrush x:Key="CheckCardBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="CheckBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="CheckControlBrush" Color="#22FFFFFF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CheckTextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource CheckTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CheckControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="CheckPrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource CheckAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CheckAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="24" ClipToBounds="True"
            BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <ui:FrostedGlassLayer x:Name="Frosted" CornerRadius="24" Intensity="1"/>
            <Grid Margin="26,20,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="媒体源检查" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="读取 Windows SMTC、Cider 与本机播放器状态" FontSize="11.5"
                                   Foreground="{DynamicResource CheckMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Width="34" Height="34" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="Close_Click" ToolTip="关闭"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="TxtStatus" Text="准备检查"
                           FontSize="12.5" Margin="2,12,0,10"/>
                <Border Grid.Row="2" CornerRadius="14" Background="{DynamicResource CheckCardBrush}"
                        BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1"
                        Padding="15,13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtResult" Text="点击“开始检查”读取当前媒体状态。"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"
                                   TextWrapping="Wrap" Foreground="{DynamicResource CheckMutedBrush}"/>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="BtnCopy" Content="复制结果" Click="Copy_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRefresh" Content="开始检查" Click="Refresh_Click"
                            Style="{StaticResource CheckPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
